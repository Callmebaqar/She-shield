# SheShield frontend environment variables
# Copy to .env.local and adjust as needed.

# The API base URL used by the build.
# In development, Vite proxies /api -> http://localhost:4000 (see vite.config.ts),
# so no VITE_API_URL is needed.
#
# In production, point this at your backend origin, e.g.:
# VITE_API_URL=https://api.yourdomain.com

# Optional: only needed if you change the dev backend port
# VITE_API_URL=http://localhost:4000

# If you build a PRODUCTION bundle served from a sub-path, set the base:
# VITE_BASE_PATH=/
