# ===== SheShield Backend Environment Variables =====
# Copy this file to .env and fill in real values. NEVER commit your real .env.

# --- Database ---
# For local development with SQLite, use:
# DATABASE_URL="file:./dev.db"
#   AND replace backend/prisma/schema.prisma with backend/prisma/schema.dev.prisma
#   (or set the schema path via package.json scripts).
#
# For production (VPS / PostgreSQL), use a PostgreSQL connection string:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sheshield?schema=public"

# --- Auth / Security ---
# Use a long random secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="generate-a-long-random-secret-hex-string"
JWT_EXPIRES_IN="7d"


# --- Server ---
PORT=4000
NODE_ENV="development"

# --- Frontend / CORS ---
# The allowed origin for the frontend (dev server or production domain).
CLIENT_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# --- External / Optional ---
# Forgot-password email delivery. SheShield ships with a development fallback
# that logs the reset link to the console. To send real emails, provide credentials
# for your provider here (e.g. Resend / SMTP) and set this to the configured provider.
EMAIL_PROVIDER="dev"
RESEND_API_KEY=""
